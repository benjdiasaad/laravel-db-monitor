{
    "name": "benjdiasaad/laravel-db-monitor",
    "description": "Real-time database health monitoring for Laravel applications. Detects slow queries, N+1 issues, duplicate queries, missing indexes, and suggests performance optimizations.",
    "keywords": [
        "laravel",
        "laravel-package",
        "laravel-13",
        "database",
        "database-monitoring",
        "performance",
        "performance-optimization",
        "slow-queries",
        "n-plus-one",
        "duplicate-queries",
        "query-analysis",
        "missing-index",
        "sql-optimization",
        "developer-tools",
        "backend-tools"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Benjdia Saad",
            "homepage": "https://github.com/benjdiasaad"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/notifications": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "BenjdiaSaad\\DbMonitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BenjdiaSaad\\DbMonitor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": ["BenjdiaSaad\\DbMonitor\\DbMonitorServiceProvider"],
            "aliases": {
                "DbMonitor": "BenjdiaSaad\\DbMonitor\\Facades\\DbMonitor"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
